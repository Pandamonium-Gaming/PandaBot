[Unit]
Description=PandaBot Discord Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pandabot
WorkingDirectory=/opt/pandabot
ExecStart=/opt/pandabot/PandaBot
EnvironmentFile=/opt/pandabot/.env
Restart=on-failure
RestartSec=5
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pandabot

# Runtime location (installed to non-standard path via dotnet-install.sh)
Environment=DOTNET_ROOT=/usr/local/dotnet

# Bot secrets / config overrides
EnvironmentFile=/opt/pandabot/.env

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pandabot

[Install]
WantedBy=multi-user.target
